# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Cloudflare D1 ─────────────────────────────────────────────────────────────
# CLOUDFLARE_DATABASE_NAME: The name you gave your D1 database (e.g. minor-testdb)
CLOUDFLARE_DATABASE_NAME=your_d1_database_name

# CLOUDFLARE_ACCOUNT_ID: Found at dash.cloudflare.com → right sidebar
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# CLOUDFLARE_DATABASE_ID: The UUID of the D1 database.
#   Run: npx wrangler d1 list   →   copy the "database_id" column value
CLOUDFLARE_DATABASE_ID=your_cloudflare_d1_database_uuid_here

# CLOUDFLARE_API_TOKEN: Required for the REST API path (350ms vs 3000ms per query).
#   Without this, the app falls back to Wrangler CLI subprocess execution
#   which adds ~3 seconds PER database call (~15–110 seconds per user query).
#
#   To generate a token:
#     1. Go to dash.cloudflare.com → Profile → API Tokens
#     2. Click "Create Token"
#     3. Use the "Edit Cloudflare Workers" template OR create a Custom Token with:
#        - Permission: Account → D1 → Edit
#        - Account Resources: Include → your account
#     4. Copy the token value and paste it here
#
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
